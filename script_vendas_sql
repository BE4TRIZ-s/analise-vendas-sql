create database loja_vendas;
use loja_vendas;

create table vendas (
	id_venda int primary key,
    data_venda date,
    produto varchar(100),
    categoria varchar(50),
    genero varchar(20),
    quantidade int, 
    valor_unitario decimal(10,2)
);

