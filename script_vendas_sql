SELECT * FROM vendas;

SELECT SUM(quantidade * valor_unitario) AS faturamento_total
FROM vendas;

SELECT COUNT(*) AS total_vendas
FROM vendas;

SELECT SUM(quantidade) AS produtos_vendidos
FROM vendas;

SELECT AVG(quantidade * valor_unitario) AS ticket_medio
FROM vendas;

SELECT ROUND(AVG(quantidade * valor_unitario), 2) AS ticket_medio
FROM vendas;

SELECT categoria, SUM(quantidade * valor_unitario) AS faturamento
FROM vendas
GROUP BY categoria
ORDER BY faturamento DESC;

SELECT genero, SUM(quantidade * valor_unitario) AS faturamento
FROM vendas
GROUP BY genero
ORDER BY faturamento DESC;

SELECT genero, categoria, SUM(quantidade * valor_unitario) AS faturamento
FROM vendas
GROUP BY genero, categoria
ORDER BY genero, faturamento DESC;

SELECT produto, SUM(quantidade * valor_unitario) AS faturamento
FROM vendas
GROUP BY produto
ORDER BY faturamento DESC;

SELECT produto, SUM(quantidade) AS quantidade_vendida
FROM vendas
GROUP BY produto
ORDER BY quantidade_vendida DESC;

SELECT categoria, ROUND(AVG(valor_unitario), 2) AS preco_medio
FROM vendas
GROUP BY categoria
ORDER BY preco_medio DESC;

SELECT MONTH(data_venda) AS mes, SUM(quantidade * valor_unitario) AS faturamento
FROM vendas
GROUP BY MONTH(data_venda)
ORDER BY mes;

