SELECT COUNT(*) AS total_registros
FROM vendas;

SELECT MONTH(data_venda) AS mes, 
	ROUND(SUM(quantidade * valor_unitario), 2) AS faturamento
FROM vendas
GROUP BY MONTH(data_venda)
ORDER BY mes;

SELECT MONTH(data_venda) AS mes, COUNT(*) AS total_vendas
FROM vendas
GROUP BY MONTH(data_venda)
ORDER BY mes;

SELECT MONTH(data_venda) AS mes, rOUND(AVG(quantidade * valor_unitario), 2) AS ticket_medio
FROM vendas
GROUP BY MONTH(data_venda)
ORDER BY mes;

SELECT MONTH(data_venda) AS mes, categoria, ROUND(SUM(quantidade * valor_unitario), 2) AS faturamento
FROM vendas
GROUP BY MONTH(data_venda), categoria
ORDER BY mes, faturamento DESC;

SELECT produto, ROUND(SUM(quantidade * valor_unitario), 2) AS faturamento
FROM vendas
GROUP BY produto
ORDER BY faturamento DESC;
